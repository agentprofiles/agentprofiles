{
  "schemaVersion": 1,
  "profiles": [
    {
      "apiVersion": "agentprofiles.io/v1",
      "kind": "AgentProfile",
      "metadata": {
        "namespace": "acme",
        "name": "base"
      },
      "spec": {
        "common": {}
      }
    },
    {
      "apiVersion": "agentprofiles.io/v1",
      "kind": "AgentProfile",
      "metadata": {
        "namespace": "acme",
        "name": "compact"
      },
      "extends": "acme/base",
      "spec": {
        "common": {
          "thinkingLevel": "low"
        },
        "example.com": {
          "mode": "compact"
        }
      }
    }
  ],
  "bindings": [
    {
      "selector": {
        "modelSizeClass": "tiny"
      },
      "profileId": "acme/compact"
    },
    {
      "selector": {
        "modelSizeClass": "small"
      },
      "profileId": "acme/compact"
    }
  ]
}
